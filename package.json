{
  "name": "hooklab-local",
  "version": "1.0.0",
  "private": true,
  "description": "Break down viral TikToks and Instagram Reels with your own LLM API keys. Runs entirely on your computer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "vite build --config client/vite.config.ts && tsx server/index.ts",
    "dev": "tsx watch --ignore ./data --ignore ./client server/index.ts --dev",
    "doctor": "tsx server/doctor.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@google/genai": "^2.29.1",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "openai": "^7.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1"
  }
}
