# OPTIONAL. You don't need this file: HookLab's setup screen saves your choices to data/settings.json.
# Use it for advanced options (model lists, port, Whisper settings) by copying it to .env:
#   cp .env.example .env
# Values saved in the app take priority over this file. Restart HookLab after changing it.
# Your keys stay on this computer. They are sent only to the provider they belong to.

# ---- LLMs: add at least one ------------------------------------------------
# Each *_MODEL can be a comma-separated list; every model shows up in the model picker.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Any OpenAI-compatible API: OpenRouter, Groq, xAI, Together, or a local Ollama / LM Studio.
#   OpenRouter: COMPAT_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:     COMPAT_BASE_URL=http://localhost:11434/v1   (no key needed)
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=
COMPAT_NAME=
# Set to false if the model can't read images (frames will be skipped).
COMPAT_VISION=true

# Model used for new chats (must match one of the models above). Defaults to the first one.
DEFAULT_MODEL=

# ---- Transcription -----------------------------------------------------------
# auto (default) tries, in order:
#   1. OpenAI Whisper  if OPENAI_API_KEY is set  (~$0.006/min, word-level timing)
#   2. Groq Whisper    if GROQ_API_KEY is set    (very cheap / free tier, word-level timing)
#   3. Local Whisper   free and private, runs on this computer (model downloads on first use)
#   4. Platform captions from TikTok/Instagram, when they exist
# Or force one: openai | groq | local | captions | off
TRANSCRIPTION=auto

GROQ_API_KEY=

# Local Whisper model from Hugging Face. Bigger = more accurate but slower:
#   Xenova/whisper-tiny, Xenova/whisper-base (default), Xenova/whisper-small
# English-only variants (add .en, e.g. Xenova/whisper-base.en) are more accurate for English.
WHISPER_MODEL=Xenova/whisper-base
# Spoken language for local Whisper (e.g. es, fr). Empty = English. The Whisper APIs auto-detect when empty.
WHISPER_LANGUAGE=

# ---- Advanced ----------------------------------------------------------------
PORT=8787
# Use your own binaries instead of the ones found on PATH / bundled.
FFMPEG_PATH=
YTDLP_PATH=
